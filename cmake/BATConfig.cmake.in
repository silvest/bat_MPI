@PACKAGE_INIT@
set(BAT_VERSION "@PROJECT_VERSION@")
include(CMakeFindDependencyMacro)
find_dependency(ROOT 6.08 COMPONENTS Core Imt RIO Net Hist Graf Graf3d Gpad Tree
  Rint Postscript Matrix Physics MathCore Minuit MathMore)
find_dependency(MPI COMPONENTS CXX)
if(@BAT_ENABLE_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@BAT_ENABLE_CUBA@)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(Cuba)
endif()
if(@BAT_ENABLE_ROOSTATS@)
  find_dependency(ROOT COMPONENTS RooFit RooFitCore RooStats)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/BATTargets.cmake")
set(BAT_HAS_PARALLEL_TEMPERING TRUE)
set(BAT_HAS_TRANSPORT_DIAGNOSTICS TRUE)
set(BAT_HAS_PT_STREAMING_DIAGNOSTICS TRUE)
set(BAT_models_FOUND @BAT_BUILD_MODELS@)
set(BAT_mtf_FOUND @BAT_BUILD_MTF@)
set(BAT_RooStats_FOUND @BAT_ENABLE_ROOSTATS@)
set(BAT_PT_FOUND TRUE)
set_and_check(BAT_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(BAT_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(BAT_INCLUDE_DIRS "${BAT_INCLUDE_DIR}")
set(BAT_LIBRARIES BAT::BAT)
check_required_components(BAT)

set(BAT_HAS_STAGED_WARMUP TRUE)
set(BAT_HAS_SMOOTH_SCALE_ADAPTATION TRUE)
