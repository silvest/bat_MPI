# Locate an existing Cuba installation and determine its supported C interface.
find_path(Cuba_INCLUDE_DIR cuba.h HINTS ${Cuba_ROOT} ENV CUBA_ROOT PATH_SUFFIXES include)
find_library(Cuba_LIBRARY NAMES cuba HINTS ${Cuba_ROOT} ENV CUBA_ROOT PATH_SUFFIXES lib lib64)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(Cuba REQUIRED_VARS Cuba_INCLUDE_DIR Cuba_LIBRARY)
if(Cuba_FOUND)
  include(CheckCXXSourceCompiles)
  set(_cuba_saved_includes "${CMAKE_REQUIRED_INCLUDES}")
  set(_cuba_saved_type "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
  set(CMAKE_REQUIRED_INCLUDES "${Cuba_INCLUDE_DIR}")
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  foreach(version IN ITEMS 41 40 33)
    if(version EQUAL 41)
      set(extra "1, 1, 0., nullptr, nullptr,")
    elseif(version EQUAL 40)
      set(extra "1, 0., nullptr, nullptr,")
    else()
      set(extra "1, 0., nullptr,")
    endif()
    unset(Cuba_INTERFACE_${version} CACHE)
    check_cxx_source_compiles("#include <cuba.h>
int f(const int*, const double*, const int*, double*, void*) { return 0; }
int main() { int regions=0, evals=0, fail=0; double result=0, error=0, prob=0;
Suave(1,1,f,nullptr,1,0.,0.,0,0,0,1,${extra}&regions,&evals,&fail,&result,&error,&prob); }
" Cuba_INTERFACE_${version})
    if(Cuba_INTERFACE_${version})
      set(Cuba_INTERFACE_VERSION ${version})
      break()
    endif()
  endforeach()
  set(CMAKE_REQUIRED_INCLUDES "${_cuba_saved_includes}")
  set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_cuba_saved_type}")
  if(NOT Cuba_INTERFACE_VERSION)
    message(FATAL_ERROR "Cuba was found, but its interface is not compatible with Cuba 3.3/4.x")
  endif()
  if(NOT TARGET Cuba::Cuba)
    add_library(Cuba::Cuba UNKNOWN IMPORTED)
    set_target_properties(Cuba::Cuba PROPERTIES IMPORTED_LOCATION "${Cuba_LIBRARY}"
      INTERFACE_INCLUDE_DIRECTORIES "${Cuba_INCLUDE_DIR}")
  endif()
endif()
mark_as_advanced(Cuba_INCLUDE_DIR Cuba_LIBRARY)
