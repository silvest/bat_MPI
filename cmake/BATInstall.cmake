set(BAT_CMAKE_INSTALL_DIR "${CMAKE_INSTALL_LIBDIR}/cmake/BAT")
configure_package_config_file(cmake/BATConfig.cmake.in "${PROJECT_BINARY_DIR}/BATConfig.cmake"
  INSTALL_DESTINATION "${BAT_CMAKE_INSTALL_DIR}"
  PATH_VARS CMAKE_INSTALL_INCLUDEDIR CMAKE_INSTALL_LIBDIR)
write_basic_package_version_file("${PROJECT_BINARY_DIR}/BATConfigVersion.cmake"
  VERSION ${PROJECT_VERSION} COMPATIBILITY SameMajorVersion)
install(EXPORT BATTargets NAMESPACE BAT:: DESTINATION "${BAT_CMAKE_INSTALL_DIR}")
install(FILES "${PROJECT_BINARY_DIR}/BATConfig.cmake" "${PROJECT_BINARY_DIR}/BATConfigVersion.cmake"
  cmake/FindCuba.cmake DESTINATION "${BAT_CMAKE_INSTALL_DIR}")

# Compatibility with projects using bat-config/pkg-config and the project generator.
find_program(BAT_ROOT_CONFIG root-config HINTS "${ROOT_BINDIR}")
if(NOT BAT_ROOT_CONFIG)
  message(FATAL_ERROR "root-config is required for the legacy bat-config compatibility script")
endif()
execute_process(COMMAND "${BAT_ROOT_CONFIG}" --cflags OUTPUT_VARIABLE BAT_COMPAT_CFLAGS OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND "${BAT_ROOT_CONFIG}" --libs OUTPUT_VARIABLE BAT_COMPAT_DEP_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE)
set(BAT_COMPAT_LIBS "-lBAT")
# Dependencies must follow their users for static linking.
if(BAT_BUILD_MODELS)
  set(BAT_COMPAT_LIBS "-lBATmodels ${BAT_COMPAT_LIBS}")
endif()
if(BAT_BUILD_MTF)
  set(BAT_COMPAT_LIBS "-lBATmtf ${BAT_COMPAT_LIBS}")
endif()
string(APPEND BAT_COMPAT_DEP_LIBS " -lMinuit -lMathMore")
if(BAT_ENABLE_ROOSTATS)
  string(APPEND BAT_COMPAT_DEP_LIBS " -lRooStats -lRooFit -lRooFitCore")
endif()
if(BAT_ENABLE_OPENMP)
  string(APPEND BAT_COMPAT_CFLAGS " ${OpenMP_CXX_FLAGS}")
  foreach(library IN LISTS OpenMP_CXX_LIBRARIES)
    string(APPEND BAT_COMPAT_DEP_LIBS " ${library}")
  endforeach()
endif()
if(BAT_ENABLE_CUBA)
  string(APPEND BAT_COMPAT_DEP_LIBS " ${Cuba_LIBRARY}")
endif()
# CMake targets propagate MPI; bat-config clients must use mpicxx, as in autotools.
file(RELATIVE_PATH BAT_BINDIR_TO_PREFIX "/${CMAKE_INSTALL_BINDIR}" "/")
configure_file(cmake/bat-config.in "${PROJECT_BINARY_DIR}/bat-config" @ONLY)
file(RELATIVE_PATH BAT_PC_TO_PREFIX "/${CMAKE_INSTALL_LIBDIR}/pkgconfig" "/")
configure_file(cmake/bat.pc.in "${PROJECT_BINARY_DIR}/bat.pc" @ONLY)
install(PROGRAMS "${PROJECT_BINARY_DIR}/bat-config" DESTINATION ${CMAKE_INSTALL_BINDIR})
install(FILES "${PROJECT_BINARY_DIR}/bat.pc" DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
install(DIRECTORY diagnostics/ DESTINATION ${CMAKE_INSTALL_DATADIR}/BAT/diagnostics)
install(FILES README.md INSTALL.md doc/COPYING doc/LICENSE DESTINATION ${CMAKE_INSTALL_DATADIR}/BAT)

set(datadir "\$(CDPATH= cd -- \"\$(dirname -- \"\$0\")/${BAT_BINDIR_TO_PREFIX}/${CMAKE_INSTALL_DATADIR}/BAT\" && pwd)")
configure_file(tools/bat-project.in "${PROJECT_BINARY_DIR}/bat-project" @ONLY)
install(PROGRAMS "${PROJECT_BINARY_DIR}/bat-project" DESTINATION ${CMAKE_INSTALL_BINDIR})
function(bat_configure_makefile_template)
  set(CXX "mpicxx")
  set(CXXFLAGS "")
  set(LD "$(CXX)")
  set(LDFLAGS "")
  configure_file(tools/MakefileTemplate.in "${PROJECT_BINARY_DIR}/MakefileTemplate" @ONLY)
endfunction()
bat_configure_makefile_template()
install(FILES tools/Main1Template.cxx tools/Main2Template.cxx tools/ModelTemplate.h
  tools/ModelTemplate.cxx "${PROJECT_BINARY_DIR}/MakefileTemplate" DESTINATION ${CMAKE_INSTALL_DATADIR}/BAT)
