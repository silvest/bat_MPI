/* Generated by CMake. Mirrors the subset of autotools config.h needed by the
 * core BAT library (CUBA/OpenMP/RooStats are not covered by the CMake build). */
#ifndef BAT_CMAKE_CONFIG_H
#define BAT_CMAKE_CONFIG_H

#define PACKAGE "@PACKAGE@"
#define PACKAGE_VERSION "@PACKAGE_VERSION@"
#define VERSION "@PACKAGE_VERSION@"

/* ROOT Version, encoded as (major * 1000 + minor) * 1000 + patch */
#define ROOTVERSION @ROOTVERSION_NUM@

#cmakedefine ROOTMATHMORE 1

/* OpenMP thread parallelization (not supported by the CMake build yet) */
#define THREAD_PARALLELIZATION 0

#endif // BAT_CMAKE_CONFIG_H
