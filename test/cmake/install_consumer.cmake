# A clean install is moved before testing. No build-tree libraries or headers
# should be needed by consumers after relocation.
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Failed: ${ARGV}\n${out}\n${err}")
  endif()
endfunction()
set(stage "${BAT_BUILD_DIR}/install-test")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}")
run("${CMAKE_COMMAND}" --install "${BAT_BUILD_DIR}" --prefix "${stage}/original" --config "${BAT_TEST_CONFIG}")
file(RENAME "${stage}/original" "${stage}/relocated prefix")
set(prefix "${stage}/relocated prefix")
foreach(variant IN ITEMS shared static)
  set(use_static OFF)
  if(variant STREQUAL "static")
    set(use_static ON)
  endif()
  run("${CMAKE_COMMAND}" -S "${BAT_SOURCE_DIR}/test/cmake/consumer" -B "${stage}/${variant}"
    "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_CXX_COMPILER=${BAT_TEST_CXX}"
    "-DBAT_STATIC_CONSUMER=${use_static}")
  run("${CMAKE_COMMAND}" --build "${stage}/${variant}" --config "${BAT_TEST_CONFIG}")
  run("${stage}/${variant}/consumer")
  run("${CMAKE_COMMAND}" --install "${stage}/${variant}" --prefix "${stage}/${variant}/installed" --config "${BAT_TEST_CONFIG}")
  run("${stage}/${variant}/installed/bin/consumer")
endforeach()
execute_process(COMMAND "${prefix}/bin/bat-config" --cflags OUTPUT_VARIABLE cflags RESULT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Installed bat-config --cflags failed")
endif()
execute_process(COMMAND "${prefix}/bin/bat-config" --libs OUTPUT_VARIABLE libs RESULT_VARIABLE status OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Installed bat-config --libs failed")
endif()
separate_arguments(cflags UNIX_COMMAND "${cflags}")
separate_arguments(libs UNIX_COMMAND "${libs}")
find_program(mpicxx NAMES mpicxx mpic++)
if(NOT mpicxx)
  message(FATAL_ERROR "MPI compiler wrapper required for bat-config compatibility test")
endif()
run("${mpicxx}" ${cflags} "${BAT_SOURCE_DIR}/test/cmake/consumer/main.cpp" ${libs} -o "${stage}/bat-config-consumer")
run("${stage}/bat-config-consumer")
run("${prefix}/bin/bat-config" --version --features --prefix)
message(STATUS "Relocated BAT installation: CMake shared/static, installed executables and bat-config consumers passed")

foreach(project IN ITEMS sample skeleton)
  if(project STREQUAL "skeleton")
    set(model "-")
  else()
    set(model "ExampleModel")
  endif()
  run("${CMAKE_COMMAND}" -E chdir "${stage}" "${prefix}/bin/bat-project" "${project}" "${model}")
  run("${CMAKE_COMMAND}" -S "${stage}/${project}" -B "${stage}/${project}/build"
    "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_CXX_COMPILER=${BAT_TEST_CXX}")
  run("${CMAKE_COMMAND}" --build "${stage}/${project}/build")
  run("${stage}/${project}/build/run${project}")
endforeach()

find_program(pkg_config NAMES pkg-config)
if(pkg_config)
  file(GLOB_RECURSE pc_files "${prefix}/*/bat.pc")
  list(GET pc_files 0 pc_file)
  get_filename_component(pc_directory "${pc_file}" DIRECTORY)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${pc_directory}"
    "${pkg_config}" --cflags --libs bat RESULT_VARIABLE status OUTPUT_VARIABLE flags OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Installed bat.pc failed")
  endif()
  separate_arguments(flags UNIX_COMMAND "${flags}")
  run("${mpicxx}" "${BAT_SOURCE_DIR}/test/cmake/consumer/main.cpp" ${flags} -o "${stage}/pkg-config-consumer")
  run("${stage}/pkg-config-consumer")
endif()
